{
  "openai": {
    "apiKey": "YOUR_OPENAI_API_KEY"
  },
  "openrouter": {
    "apiKey": "YOUR_OPENROUTER_API_KEY_OPTIONAL",
    "defaultModel": "openai/gpt-5.5",
    "favoriteModels": [
      "openai/gpt-5.5",
      "anthropic/claude-sonnet-4.5",
      "deepseek/deepseek-v4-pro",
      "google/gemma-4-26b-a4b-it:free",
      "google/gemma-4-31b-it:free",
      "openai/gpt-oss-120b:free"
    ]
  },
  "tavily": {
    "apiKey": "YOUR_TAVILY_API_KEY"
  },
  "cors": {
    "allowedOrigins": [
      "http://localhost:8080",
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:8787"
    ]
  },
  "server": {
    "port": 8787,
    "https": {
      "enabled": false,
      "port": 8443,
      "key": "./ssl/private.key",
      "cert": "./ssl/certificate.crt"
    }
  },
  "agent": {
    "enabled": true,
    "localOnly": true,
    "allowYolo": true,
    "reasoningLevel": "high",
    "dbPath": "agent.sqlite",
    "commandTimeoutMs": 600000,
    "maxOutputBytes": 1048576,
    "requestMaxLength": 20000,
    "commandMaxLength": 20000,
    "maxActionsPerApproval": 32,
    "retentionDays": 30,
    "maxRuns": 100,
    "maxEventsPerRun": 2000
  },
  "userSettings": {
    "theme": "matrix",
    "openaiModel": "gpt-5.6-sol",
    "city": "",
    "state": "",
    "subreddits": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ],
    "showInspirationQuote": true,
    "showCalculator": true,
    "showClock": true,
    "clockView": "analog-marks",
    "showAnalogClockFrame": true,
    "analogClockFrameWidth": 10,
    "showNews": true,
    "showReddit": false,
    "showAgent": true,
    "roundedBorders": true
  }
}
